# Copy this file to .env and replace the placeholders with your private values.
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
AIRTABLE_TOKEN=your_airtable_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Videos
OPENAI_API_KEY=your_openai_api_key
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id
EMAIL_REMETENTE=your_email@gmail.com
EMAIL_SENHA=your_email_app_password
EMAIL_DESTINATARIO=recipient_email@gmail.com
EMAIL_SMTP_SERVIDOR=smtp.gmail.com
EMAIL_SMTP_PORTA=465
